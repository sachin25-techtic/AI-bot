PORT=3001
# Where the Next.js app runs (for CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Ollama (called through its OpenAI-compatible API at OLLAMA_BASE_URL/v1)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Default randomness for plain chat (0 = predictable, 1+ = creative). RAG answers use 0.1.
OLLAMA_TEMPERATURE=0.7
# Max time (ms) for Ollama to start answering, including loading the model into memory.
OLLAMA_TIMEOUT_MS=120000

# Postgres + pgvector (phase 2 / RAG)
DATABASE_URL=postgres://aibot:aibot@localhost:5433/aibot
# Minimum similarity (0-1) for a chunk to count as relevant. Below it: "not found".
RAG_MIN_SCORE=0.6

# Demo: corrupt the first summarise reply to watch the validate-and-retry loop work.
SUMMARISE_DEBUG_BREAK_FIRST_ATTEMPT=false
